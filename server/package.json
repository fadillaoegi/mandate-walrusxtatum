{
  "name": "@mandate/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spike:walrus-write": "tsx --env-file=../.env src/spike/walrus-write.ts",
    "spike:walrus-recall": "tsx --env-file=../.env src/spike/walrus-recall.ts",
    "spike:tatum": "tsx --env-file=../.env src/spike/tatum-read.ts",
    "spike:x402": "tsx src/spike/x402-offline.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "wallet:testnet": "node --import tsx src/spike/testnet-wallet.ts",
    "spike:tatum-testnet": "tsx --env-file=../.env src/spike/tatum-testnet-probe.ts",
    "spike:revoke-check": "tsx --env-file=../.env src/spike/walrus-revoke-check.ts",
    "spike:x402-testnet": "tsx --env-file=../.env src/spike/x402-testnet-pay.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@mysten-incubation/memwal": "^0.1.12",
    "@mysten/seal": "^1.5.2",
    "@mysten/sui": "^2.38.0",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "@t2000/sui-x402": "11.7.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
