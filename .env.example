# Copy to .env and fill in locally. Never commit .env.

# --- Server ---
API_PORT=8120
WEB_ORIGIN=http://localhost:5190
DATABASE_URL=postgres://mandate:mandate@localhost:5450/mandate
HOST=127.0.0.1
# Optional: serve the built dashboard from the API (e.g. web/dist).
WEB_DIST=
# Optional: public viewing; actions need this passcode. Set before publishing.
DEMO_PASSCODE=

# --- Walrus Memory (Mainnet relayer) ---
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_ACCOUNT_ID=
# Delegate Ed25519 private key (hex or suiprivkey1...). SECRET.
MEMWAL_PRIVATE_KEY=
# Public half of the delegate key (= MEMWAL_AGENT_ID on the submission form). Not secret.
MEMWAL_PUBLIC_KEY=
MEMWAL_NAMESPACE=mandate-demo

# --- Tatum Sui RPC ---
# grpc (default) or jsonrpc (legacy; Sui deprecated JSON-RPC in 2026)
TATUM_SUI_TRANSPORT=grpc
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
# SECRET.
TATUM_API_KEY=

# local (Postgres stand-in, dev only) | walrus (Walrus Memory Mainnet)
MEMORY_MODE=local

# local ledger (default) | Sui Testnet via Tatum (test USDC) | older simulated rail
PAYMENT_RAIL=x402-local
# Agent wallet for x402-testnet (test tokens only). Create with: npm run wallet:testnet -w server -- init
AGENT_WALLET_PRIVATE_KEY=
TATUM_SUI_TESTNET_GRPC_URL=https://sui-testnet-grpc.gateway.tatum.io
# Only if Tatum gives you a separate testnet key; otherwise TATUM_API_KEY is used
TATUM_TESTNET_API_KEY=
# Second, throwaway delegate key for the live revoke test (spike:revoke-check)
MEMWAL_TEST_PRIVATE_KEY=
